# styles.css is generated from the class names in index.html, so the two must
# never be served out of step. Cloudflare's default for static assets is a
# 4-hour cache, which would leave returning visitors on new HTML with old CSS
# after a deploy. Revalidate it on every load instead; unchanged responses come
# back as a cheap 304.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
  X-Rule-Probe: styles-rule-matched

# Photos are content-addressed by name and effectively never change.
/photos/*
  Cache-Control: public, max-age=31536000, immutable
